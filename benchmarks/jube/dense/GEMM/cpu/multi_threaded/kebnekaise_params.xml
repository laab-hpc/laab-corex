<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <tags forced="true">
    <check_tags>cpu_sky|cpu_zen3|cpu_zen4|gpu_sky|gpu_zen3|gpu_zen4</check_tags>
    <tag name="cpu_sky">2 x 14 core Intel skylake (48 nodes)</tag>
    <tag name="cpu_zen3">2 x 64 core AMD zen3 (1 node)</tag>
    <tag name="cpu_zen4">2 x 128 core AMD zen4 (8 nodes)</tag>
    <tag name="gpu_sky">2 x 14 core Intel skylake + 2 x Nvidia V100 (10 nodes)</tag>
    <tag name="gpu_zen3">2 x 24 core AMD zen3 + 2 x Nvidia A6000 (2 nodes)</tag>
    <tag name="gpu_zen4">2 x 24 core AMD zen4 + 2 x Nvidia L40s (10 nodes)</tag>
  </tags>
  
    <parameterset name="system_params">
      
      <parameter name="nthreads" type="int" tag="cpu_sky">1,4,14</parameter>
      <parameter name="nthreads" type="int" tag="cpu_zen3">1,4,64</parameter>
      <parameter name="nthreads" type="int" tag="cpu_zen4">1,4,128</parameter>
      <parameter name="nthreads" type="int" tag="gpu_sky">1,4,14</parameter>
      <parameter name="nthreads" type="int" tag="gpu_zen3">1,4,24</parameter>
      <parameter name="nthreads" type="int" tag="gpu_zen4">1,4,24</parameter>

      <parameter name="src_root">/proj/nobackup/aravind/LAAB/benchmarks/linx-benchmarks</parameter>
      <parameter name="data_dir">${src_root}/benchmarks/data</parameter>

      <parameter name="arch" tag="cpu_sky">
#SBATCH -C skylake
      </parameter>
      <parameter name="arch" tag="cpu_zen3">
#SBATCH -C zen3
      </parameter>
      <parameter name="arch" tag="cpu_zen4">
#SBATCH -C zen4
      </parameter>
      <parameter name="arch" tag="gpu_sky">
#SBATCH --gpus=1
#SBATCH -C skylake&amp;v100
      </parameter>
      <parameter name="arch" tag="gpu_zen3">
#SBATCH --gpus=1
#SBATCH -C zen3&amp;a6000
      </parameter>
      <parameter name="arch" tag="gpu_zen4">
#SBATCH --gpus=1
#SBATCH -C zen4&amp;l40s
      </parameter>
    
      <parameter name="account_config">
#SBATCH --cpus-per-task=${nthreads}
#SBATCH -A hpc2n2026-184
#SBATCH --threads-per-core=1
${arch}
      </parameter>
    </parameterset>
</jube>