<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <benchmark name="linx-openblas" outpath="artifacts">
    <comment>linx-openblas</comment>

    <!-- Configuration -->
    <parameterset name="benchmark_param">
      <parameter name="nthreads" type="int">1,4,12,24</parameter>
      <parameter name="src_root">/proj/nobackup/aravind/LAAB/benchmarks/linx-benchmarks</parameter>
      <parameter name="data_dir">${src_root}/benchmarks/data</parameter>
    </parameterset>

    <!-- Files -->
    <fileset name="files">
      <copy>../cblas.submit.in</copy>
    </fileset>

    <!-- Substitute -->
    <substituteset name="slurm_substitute">
      <iofile in="cblas.submit.in" out="submit.sh" />
      <sub source="#ACCOUNT_CONFIG#">
#SBATCH --cpus-per-task=24
#SBATCH -A hpc2n2026-184
      </sub>
      <sub source="#MODULES#">
module load GCC AOCL-BLAS FlexiBLAS
      </sub>
      <sub source="#BLAS_LINKER#">-lblis-mt</sub>
      <sub source="#SRC_ROOT#" dest="$src_root" />
      <sub source="#DATA_DIR#" dest="$data_dir" />
      <sub source="#NTHREADS#" dest="$nthreads" />
    </substituteset>

    <!-- Operation -->
    <step name="exec_step">
      <use>benchmark_param</use> <!-- use existing parameterset -->
      <use>files</use>        <!-- use existing fileset -->
      <use>slurm_substitute</use>   <!-- use existing substituteset -->
      <do>sbatch submit.sh</do>   <!-- shell command -->
    </step>
  </benchmark>
</jube>
