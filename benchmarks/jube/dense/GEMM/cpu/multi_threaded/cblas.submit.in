#!/bin/bash
#SBATCH --job-name=mt_gemm
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=#NTHREADS#
#SBATCH --time=00:20:00
#SBATCH --output=slurm.out
#SBATCH --error=slurm.err
#ACCOUNT_CONFIG#

set -euo pipefail


SRC_DIR=#SRC_ROOT#/src/benchmark_codes/dense/GEMM/cpu/multi_threaded/cblas
DATA_DIR=#DATA_DIR#

lscpu > cpu_info.txt 

export LAAB_BUILD_DIR=$(pwd)/build

#MODULES#

REPS="${REPS:-5}"

NT=#NTHREADS#
export OMP_NUM_THREADS=$NT

make -C $SRC_DIR clean
make -C $SRC_DIR LD_BLAS=#BLAS_LINKER#
srun $LAAB_BUILD_DIR/correctness.exe > traces.txt

srun -c $NT "$LAAB_BUILD_DIR/dgemm.exe" -m 3000 -n 3000 --reps "$REPS" >> traces.txt
srun -c $NT "$LAAB_BUILD_DIR/dgemm.exe" -m 1000 -n 1000 --reps "$REPS" >> traces.txt
srun -c $NT "$LAAB_BUILD_DIR/dgemm.exe" -m 200 -n 1000 --reps "$REPS" >> traces.txt
srun -c $NT "$LAAB_BUILD_DIR/dgemm.exe" -m 200 -n 200 --reps "$REPS" >> traces.txt

srun -c $NT "$LAAB_BUILD_DIR/sgemm.exe" -m 3000 -n 3000 --reps "$REPS" >> traces.txt
srun -c $NT "$LAAB_BUILD_DIR/sgemm.exe" -m 1000 -n 1000 --reps "$REPS" >> traces.txt
srun -c $NT "$LAAB_BUILD_DIR/sgemm.exe" -m 200 -n 1000 --reps "$REPS" >> traces.txt
srun -c $NT "$LAAB_BUILD_DIR/sgemm.exe" -m 200 -n 200 --reps "$REPS" >> traces.txt

