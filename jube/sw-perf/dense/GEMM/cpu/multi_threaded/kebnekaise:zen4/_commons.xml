<?xml version="1.0" encoding="UTF-8"?>
<jube>
    <parameterset name="param_set">
        <parameter name="src">/pfs/proj/nobackup/fs/projnb10/aravind/LAAB/benchmarks/laab-core/src/benchmark_codes/dense/GEMM/cpu/multi_threaded/cblas/src</parameter>
        <parameter name="inputs_dir">/pfs/proj/nobackup/fs/projnb10/aravind/LAAB/benchmarks/laab-core/inputs</parameter>
        <parameter name="nthreads" type="int">1,4,24</parameter>
        <parameter name="reps">10</parameter>
        <parameter name="account_config">
#SBATCH -A hpc2n2026-184
#SBATCH -C zen4
      </parameter>
    </parameterset>

        <!-- Files -->
    <files>
        <fileset name="files">
        <copy>../cblas.submit.in</copy>
        <copy target_dir="../../">${src}</copy>
        <copy target_dir="../../example">${src}/../test/*.sh</copy>
        <copy target_dir="../../inputs">${src}/../inputs/generate_input_matrices.sh</copy>
        </fileset>
    </files>

    <!-- Substitute -->
    <subs>
        <substituteset name="substitutes">
        <iofile in="cblas.submit.in" out="submit.sh" />
        <sub source="#ACCOUNT_CONFIG#" dest="$account_config" /> 
        <sub source="#MODULES#"  dest="$modules" />
        <sub source="#COMPILE_OPTS#" dest="$compile_opts" />
        <sub source="#NTHREADS#" dest="$nthreads" />
        </substituteset>
    </subs>
    
    <steps>
      <use>param_set</use> 
      <use>files</use> 
      <use>substitutes</use>
      <do>INPUTS_DIR=${inputs_dir} REPS=${reps} sbatch submit.sh</do>           
      <!-- <do>cat submit.sh</do>            -->
    </steps>

</jube>