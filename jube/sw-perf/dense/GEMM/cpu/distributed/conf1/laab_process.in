#!/bin/bash

#LAAB_POSTPROCESS_DEPS#

laab-process traces/ \
    --name "dense/GEMM/cpu/distributed" \
    --system #SYSTEM# \
    --lib #LIB# \
    --version #VERSION# \
    --toolchain #TOOLCHAIN# \
    --np #NPE# \
    --work_dist "-N #NNODES# -tpN #NTASKS_PER_NODE# -c #NCPUS_PER_TASK#" \
    --pinning="#PINNING#" \
    --cb_id #CB_ID# \
    --options "multi-threaded" \
    --profile_dir "../../../profiles"