<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <benchmark name="laab-core" outpath="artifacts/scalapack-2.2.2-gompi-2025b-fb">
    <comment>laab-core</comment>

    <!-- Configuration -->
    <parameterset name="param_set" init_with="_commons.xml">
      <parameter name="lib">scalapack</parameter>
      <parameter name="version">2.2.2</parameter>
      <parameter name="toolchain">gompi-2025b-fb</parameter>
      <parameter name="modules">
module purge
module load GCC/14.3.0 OpenMPI/5.0.8 ScaLAPACK/2.2.2-fb
      </parameter>
      <parameter name="compile_opts">LD_SCALAPACK=-lscalapack LD_BLAS=-lopenblas</parameter>
    </parameterset>

    <!-- Files -->
    <include from="_commons.xml" path="files/" />
    <!-- Substitute -->
    <include from="_commons.xml" path="subs/" />

    <!-- Operation -->
    <step name="bm">
      <include from="_commons.xml" path="steps/" />
    </step>
  </benchmark>
</jube>
