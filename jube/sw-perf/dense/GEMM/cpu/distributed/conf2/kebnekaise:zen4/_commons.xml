<?xml version="1.0" encoding="UTF-8"?>
<jube>
    <parameterset name="param_set">
        <parameter name="system">kebnekaise:zen4</parameter>
        <parameter name="root">/proj/nobackup/aravind/LAAB-HPC/benchmarks/laab-corex</parameter>
        <parameter name="src">${root}/src/benchmark_codes/dense/GEMM/cpu/distributed/scalapack/src</parameter>
        <parameter name="inputs_dir">${root}/inputs</parameter>
        <parameter name="nnodes" type="int">1,2,4</parameter>
        <parameter name="ntasks_per_node" type="int">24</parameter>
        <parameter name="ntasks" mode="python" type="int">${ntasks_per_node}*${nnodes}</parameter>
        <parameter name="ncpus_per_task" type="int">1</parameter>
        <parameter name="npe" mode="python" type="int">${ntasks}*${ncpus_per_task}</parameter>
        <parameter name="reps">10</parameter>
        <parameter name="account_config">
#SBATCH -A hpc2n2026-184
#SBATCH -C zen4
      </parameter>
      <parameter name="pinning">--cpu-bind=threads --distribution=block:cyclic:cyclic --threads-per-core=1</parameter>
      <parameter name="laab_postprocess_deps">
source ${root}/venvs/laab-kebnekaise/activate.sh
    </parameter>
    </parameterset>

    <!-- Files -->
    <files>
        <fileset name="files">
        <copy>../submit.in</copy>
        <copy>../laab_process.in</copy>
        <copy target_dir="../../">${src}</copy>
        <copy target_dir="../../example">${src}/../test/*.sh</copy>
        <copy target_dir="../../inputs">${src}/../inputs/generate_input_matrices.sh</copy>
        </fileset>
    </files>

    <!-- Substitute -->
    <subs>
        <substituteset name="substitutes">
        <iofile in="submit.in" out="submit.sh" />
        <iofile in="laab_process.in" out="laab_process.sh" />
        <sub source="#ACCOUNT_CONFIG#" dest="$account_config" />
        <sub source="#MODULES#" dest="$modules" />
        <sub source="#COMPILE_OPTS#" dest="$compile_opts" />
        <sub source="#NCPUS_PER_TASK#" dest="$ncpus_per_task" />
        <sub source="#NNODES#" dest="$nnodes" />
        <sub source="#NTASKS#" dest="$ntasks" />
        <sub source="#NTASKS_PER_NODE#" dest="$ntasks_per_node" />
        <sub source="#NPE#" dest="$npe" />
        <sub source="#SYSTEM#" dest="$system" />
        <sub source="#LIB#" dest="$lib" />
        <sub source="#VERSION#" dest="$version" />
        <sub source="#TOOLCHAIN#" dest="$toolchain" />
        <sub source="#PINNING#" dest="$pinning" />
        <sub source="#CB_ID#" dest="$jube_benchmark_id" />
        <sub source="#LAAB_POSTPROCESS_DEPS#" dest="$laab_postprocess_deps" />
        </substituteset>
    </subs>

    <steps>
      <use>param_set</use>
      <use>files</use>
      <use>substitutes</use>
      <do>INPUTS_DIR=${inputs_dir} REPS=${reps} sbatch submit.sh</do>
      <!-- <do>cat submit.sh</do> -->
    </steps>

</jube>
