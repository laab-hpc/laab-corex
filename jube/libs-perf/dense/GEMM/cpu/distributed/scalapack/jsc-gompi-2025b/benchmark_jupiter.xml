<?xml version="1.0" encoding="UTF-8"?>
<jube>
  <benchmark name="scalapack-pdgemm-jupiter" outpath="artifacts_jupiter">
    <comment>ScaLAPACK-pdegmm-JUPITER</comment>

    <!-- Configuration -->
    <parameterset name="system_params">
      <parameter name="nodes" type="int">1,2,4</parameter>
      <parameter name="ntasks_per_node" type="int">4</parameter>
      <parameter name="cpus_per_task" type="int">72</parameter>
      <parameter name="src_root">/e/project1/cjsc/sankaran2/llview-apps/benchmarks/laab-core</parameter>
      <parameter name="data_dir">${src_root}/benchmarks/data</parameter>
      <parameter name="account_config">
#SBATCH -A zam
#SBATCH --partition booster
      </parameter>
    </parameterset>

    <parameterset name="lib_params">
      <parameter name="modules">
module purge
module load Stages/2026
module load GCC OpenMPI ScaLAPACK
      </parameter>
      <parameter name="scalapack_linker">-lscalapack</parameter>
      <parameter name="blas_linker">-lopenblas</parameter>
    </parameterset>

    <!-- Files -->
    <fileset name="files">
      <copy>../../scalapack.submit.in</copy>
    </fileset>

    <!-- Substitute -->
    <substituteset name="slurm_substitute">
      <iofile in="scalapack.submit.in" out="submit.sh" />
      <sub source="#ACCOUNT_CONFIG#" dest="$account_config" /> 
      <sub source="#MODULES#"  dest="$modules" />
      <sub source="#SCALAPACK_LINKER#" dest="$scalapack_linker" />
      <sub source="#BLAS_LINKER#" dest="$blas_linker" />
      <sub source="#SRC_ROOT#" dest="$src_root" />
      <sub source="#DATA_DIR#" dest="$data_dir" />
      <sub source="#NODES#" dest="$nodes" />
      <sub source="#NTASKS_PER_NODE#" dest="$ntasks_per_node" />
      <sub source="#CPUS_PER_TASK#" dest="$cpus_per_task" />
    </substituteset>

    <!-- Operation -->
    <step name="exec_step">
      <use>system_params</use> 
      <use>lib_params</use> 
      <use>files</use>       
      <use>slurm_substitute</use>   <!-- use existing substituteset -->
      <do>sbatch submit.sh</do>   <!-- shell command -->
    </step>
  </benchmark>
</jube>
