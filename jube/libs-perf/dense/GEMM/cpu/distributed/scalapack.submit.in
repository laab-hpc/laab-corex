#!/bin/bash
#SBATCH --job-name=distributed_gemm
#SBATCH --nodes=#NODES#
#SBATCH --ntasks-per-node=#NTASKS_PER_NODE#
#SBATCH --cpus-per-task=#CPUS_PER_TASK#
#SBATCH --time=00:20:00
#SBATCH --output=slurm.out
#SBATCH --error=slurm.err
#ACCOUNT_CONFIG#

set -euo pipefail


SRC_DIR=#SRC_ROOT#/src/benchmark_codes/dense/GEMM/cpu/distributed/scalapack
DATA_DIR=#DATA_DIR#


#MODULES#

set -euo pipefail


lscpu > cpu_info.txt 
export LAAB_BUILD_DIR=$(pwd)/build
export LAAB_TRACE_DIR=$(pwd)/traces
mkdir -p $LAAB_TRACE_DIR


make -C $SRC_DIR clean
make -C $SRC_DIR LD_SCALAPACK=#SCALAPACK_LINKER# LD_BLAS=#BLAS_LINKER#


MATRIX_DIR=#SRC_ROOT#/matrices/dense

srun -N #NODES# --ntasks-per-node #NTASKS_PER_NODE#  -c #CPUS_PER_TASK# ./build/pdgemm.exe -A $MATRIX_DIR/M15000x15000-float64-gen.dense -B $MATRIX_DIR/M15000x15000-float64-gen.dense -b 256 --reps 5
